{
  "name": "statoz-designer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/studio.mjs dev",
    "build": "node scripts/build-compositions.mjs && next build",
    "start": "node scripts/studio.mjs start",
    "worker": "tsx src/server/worker.ts",
    "publisher": "tsx src/server/publisher.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:media": "tsx scripts/verify-media.ts",
    "test:pitch-exports": "tsx scripts/verify-pitch-exports.ts",
    "test:pitch-ui": "tsx scripts/verify-pitch-ui.ts",
    "test:investor-agent": "tsx --test --test-name-pattern [Ii]nvestor tests/agent.test.ts tests/investor-review.test.ts",
    "test:studio": "tsx scripts/verify-studio.ts",
    "test:ui": "tsx scripts/verify-ui.ts",
    "test:audio-video": "tsx scripts/verify-audio-video.ts",
    "test:publish": "tsx scripts/verify-publish.ts",
    "doctor": "tsx scripts/doctor.ts",
    "compositions": "node scripts/build-compositions.mjs",
    "import:players": "tsx scripts/import-players.ts",
    "import:line-art": "tsx scripts/import-line-art.ts",
    "test:line-art": "tsx scripts/verify-line-art.ts",
    "assistant": "tsx src/server/agent.ts",
    "test:espn": "tsx scripts/verify-espn.ts"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "next": "16.3.2",
    "pdf-lib": "^1.17.1",
    "pptxgenjs": "^4.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.25",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "playwright": "^1.55",
    "tailwindcss": "^4",
    "tsx": "^4",
    "typescript": "^5"
  }
}
